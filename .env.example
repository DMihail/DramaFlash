# Machine-local overrides belong in .env.local, which is gitignored.
# Expo inlines only EXPO_PUBLIC_ variables into the app bundle.
# Never put credentials, tokens, or private keys in EXPO_PUBLIC_ variables.
#
# APP_VARIANT is set by the npm scripts and by eas.json. Do not set it here.
# EAS development and production environments are selected in eas.json.
# Store secrets for those environments with `eas env:create`, not in git.
#
# EXPO_PUBLIC_API_URL=https://example.com
