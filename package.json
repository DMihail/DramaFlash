{
  "name": "drama-flash",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "expo-doctor": "^1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "android": "APP_VARIANT=development expo run --android",
    "ios": "APP_VARIANT=development expo run --ios",
    "web": "APP_VARIANT=development expo start --web",
    "export:web": "APP_VARIANT=production expo export --platform web --clear && node scripts/check-web-export.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll=false --watchman=false",
    "test:watch": "jest --watchAll",
    "doctor": "expo-doctor",
    "e2e": "maestro test tests/e2e/maestro",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run doctor",
    "eas-build-pre-install": "npm install --global npm@11.19.0"
  },
  "jest": {
    "preset": "jest-expo",
    "passWithNoTests": false,
    "testMatch": [
      "<rootDir>/tests/**/*-test.ts",
      "<rootDir>/tests/**/*-test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/High-Fidelity DramaFlash Prototype/",
      "/references/"
    ]
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "private": true
}
